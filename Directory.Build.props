<Project>

  <!--
    Solution-wide build settings.
    Kept in one place so every project stays on identical language/analysis rules.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gate: the build fails on warnings so code review never has to argue about them. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      InvariantGlobalization is deliberately NOT enabled. Flipping that switch would mask the
      culture problem rather than solve it: the code would still be calling culture-sensitive
      overloads, and would start corrupting data the day someone turned the switch off or ran a
      component that needs real culture data. Correctness is enforced at each call site instead —
      ToUpperInvariant, explicit StringComparison — with CA1304/CA1305/CA1310 as build errors, and
      a test that runs under tr-TR to prove it.
    -->
  </PropertyGroup>

</Project>
