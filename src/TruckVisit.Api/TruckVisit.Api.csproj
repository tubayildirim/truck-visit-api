<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The integration test project drives the pipeline through WebApplicationFactory. -->
    <UserSecretsId>truckvisit-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />

    <!--
      Design-time only. The EF tools resolve the DbContext through the *startup* project, so the
      reference has to be here even though the context itself lives in Infrastructure.
      PrivateAssets keeps it out of the published output: it is a build-time tool, and shipping it
      into the runtime image would add surface area for nothing.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TruckVisit.Application\TruckVisit.Application.csproj" />
    <ProjectReference Include="..\TruckVisit.Infrastructure\TruckVisit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TruckVisit.Api.IntegrationTests" />
  </ItemGroup>

</Project>
