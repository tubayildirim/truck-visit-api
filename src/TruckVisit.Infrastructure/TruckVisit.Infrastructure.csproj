<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TruckVisit.Application\TruckVisit.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository and the idempotency store are internal by design: nothing outside this
         assembly should construct them. The integration tests exercise them directly because
         that is where the persistence guarantees actually live. -->
    <InternalsVisibleTo Include="TruckVisit.Api.IntegrationTests" />
  </ItemGroup>

</Project>
